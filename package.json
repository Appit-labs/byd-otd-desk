{
  "name": "byd-otd-desk",
  "version": "0.1.0",
  "private": true,
  "description": "BYD OTD Tracker - Order to Delivery Tracking System",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend",
    "test": "npm run test --workspace=backend",
    "test:e2e": "npm run test:e2e --workspace=backend",
    "migration:generate": "npm run migration:generate --workspace=backend",
    "migration:run": "npm run migration:run --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "fallow": "^2.96.0"
  },
  "dependencies": {
    "nodemailer": "^9.0.0"
  }
}

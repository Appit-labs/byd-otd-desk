# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=byd_otd_desk
DB_SYNC=false
DB_LOGGING=false

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRY=8h

# ──────────────────────────────────────────────────────────────
# Email Notification Configuration
# ──────────────────────────────────────────────────────────────
# Required for SMTP password encryption — strong random string, never committed
APP_SECRET=change-me-to-a-strong-random-string-at-least-32-chars

# App base URL for email CTA links (used in notification emails)
APP_BASE_URL=http://localhost:5173

# Fallback SMTP — used when no DB email config row exists (local/dev/staging)
# Uses Resend onboarding@resend.dev sender for zero-config testing
FALLBACK_SMTP_HOST=smtp.resend.com
FALLBACK_SMTP_PORT=465
FALLBACK_SMTP_USER=resend
FALLBACK_SMTP_PASS=re_placeholder_resend_api_key
FALLBACK_FROM_ADDRESS=onboarding@resend.dev
FALLBACK_FROM_NAME=BYD OTD Desk

{{#> layouts/base}}
  {{#*inline "body"}}
    <h2 style="margin:0 0 12px;color:#1a1a2e;font-size:18px;font-weight:700;">Email Configuration Test</h2>
    <p style="margin:0 0 16px;color:#555555;font-size:15px;line-height:1.5;">
      Your SMTP configuration is working correctly.<br>
      This confirms that BYD OTD Desk can send email notifications.
    </p>
    <div style="background-color:#f0f9eb;border:1px solid #c3e6b5;border-radius:4px;padding:12px 16px;margin:16px 0;">
      <p style="margin:0;color:#2d7d2a;font-size:14px;font-weight:600;">&#10003; Connection Successful</p>
    </div>
    <p style="color:#999999;font-size:12px;margin:16px 0 0;">
      Sent at: {{sentAt}}<br>
      SMTP Host: {{smtpHost}}
    </p>
  {{/inline}}
{{/layouts/base}}
